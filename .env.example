# chitAbit Environment Configuration

# Server Port (Default: 3001)
PORT=3001

# Google Gemini API Key for DevBot Senior AI Assistant
# Get your free API key at: https://aistudio.google.com/
# If left empty, DevBot will automatically run in interactive Demo Mode!
GEMINI_API_KEY=your_gemini_api_key_here

# Secret used to sign login tokens (JWT). REQUIRED in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# Gemini model DevBot uses (optional)
GEMINI_MODEL=gemini-2.5-flash

# Max DevBot questions per user per minute (optional, default 5)
DEVBOT_MAX_PER_MINUTE=5

# Websites allowed to call the API from a browser, comma-separated (optional).
# Leave empty in development. In production set your frontend URL, e.g. https://chitabit.app
CLIENT_ORIGIN=

# Database file (optional). Default: data/chat.db in the project root.
# A relative path starts from the server/ folder. Tests always use an in-memory DB.
# DB_PATH=/var/lib/chitabit/chat.db
